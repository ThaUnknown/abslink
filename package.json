{
  "name": "abslink",
  "type": "module",
  "version": "1.0.4",
  "description": "IPC for abstract message channels, comlink style.",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "adapters",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ThaUnknown/abslink.git"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/src/abslink.d.ts",
      "import": "./dist/esm/abslink.mjs",
      "require": "./dist/umd/abslink.js",
      "default": "./dist/esm/abslink.mjs"
    },
    "./worker": {
      "types": "./dist/esm/adapters/worker.d.ts",
      "import": "./dist/esm/worker.mjs",
      "require": "./dist/umd/worker.js",
      "default": "./dist/esm/worker.js"
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.1.2",
    "@types/node": "^22.10.4",
    "rimraf": "^6.0.1",
    "rollup": "4.29.1",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "5.7.2"
  }
}