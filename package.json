{
  "name": "abslink",
  "type": "module",
  "version": "1.0.11",
  "description": "IPC for abstract message channels, comlink style.",
  "sideEffects": false,
  "files": [
    "src",
    "adapters",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ThaUnknown/abslink.git"
  },
  "exports": {
    ".": {
      "types": "./src/abslink.d.ts",
      "import": "./src/abslink.js",
      "default": "./src/abslink.js"
    },
    "./worker": {
      "types": "./adapters/worker.d.ts",
      "import": "./adapters/worker.js",
      "default": "./adapters/worker.js"
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.10.4",
    "typescript": "5.7.2"
  }
}